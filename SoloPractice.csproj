<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--
    Restore the runtime-specific packages needed for every release target.
    This only applies to Release builds so Debug remains fast.
  -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RuntimeIdentifiers>
			win-x64;
			win-arm64;
			osx-arm64;
			osx-x64;
			linux-x64;
			linux-arm64
		</RuntimeIdentifiers>

		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data/schema.sql" />
	</ItemGroup>

	<!--
    When Visual Studio finishes a normal Release build, publish
    self-contained versions for every supported platform.
  -->
	<Target
	  Name="PublishAllReleasePlatforms"
	  AfterTargets="Build"
	  Condition="
      '$(Configuration)' == 'Release'
      and '$(RuntimeIdentifier)' == ''
      and '$(SkipMultiPlatformPublish)' != 'true'">

		<Message
		  Importance="high"
		  Text="Publishing SoloPractice for Windows, macOS, and Linux..." />

		<!-- Windows x64 -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=win-x64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/win-x64/;
        SkipMultiPlatformPublish=true" />

		<!-- Windows ARM64 -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=win-arm64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/win-arm64/;
        SkipMultiPlatformPublish=true" />

		<!-- macOS Apple Silicon -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=osx-arm64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/osx-arm64/;
        SkipMultiPlatformPublish=true" />

		<!-- macOS Intel -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=osx-x64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/osx-x64/;
        SkipMultiPlatformPublish=true" />

		<!-- Linux x64 -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=linux-x64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/linux-x64/;
        SkipMultiPlatformPublish=true" />

		<!-- Linux ARM64 -->
		<MSBuild
		  Projects="$(MSBuildProjectFullPath)"
		  Targets="Publish"
		  Properties="
        Configuration=Release;
        RuntimeIdentifier=linux-arm64;
        SelfContained=true;
        PublishSingleFile=true;
        IncludeNativeLibrariesForSelfExtract=true;
        PublishDir=$(MSBuildProjectDirectory)/publish/linux-arm64/;
        SkipMultiPlatformPublish=true" />

	</Target>

</Project>